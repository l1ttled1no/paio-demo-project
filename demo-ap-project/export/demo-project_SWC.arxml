                  <REQUESTER-IREF>
                    <CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/SwComponentType/Composition/HPC_0/IVI</CONTEXT-COMPONENT-REF>
                    <TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/SwComponentType/AdaptiveApplication/IVIApp/RPort_0</TARGET-R-PORT-REF>
