                </P-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RPort_Logging_Gear</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="LOG-AND-TRACE-INTERFACE">/PortInterface/Adaptive/LogAndTrace/Logging_and_Tracing</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
              <INTERNAL-BEHAVIORS>
