              <SHORT-NAME>System</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Root SW Composition</L-2>
              </DESC>
              <COMPONENTS>
                <SW-COMPONENT-PROTOTYPE>
                  <SHORT-NAME>HPC_0</SHORT-NAME>
                  <TYPE-TREF DEST="COMPOSITION-SW-COMPONENT-TYPE">/SwComponentType/Composition/HPC_0</TYPE-TREF>
                </SW-COMPONENT-PROTOTYPE>
              </COMPONENTS>
            </COMPOSITION-SW-COMPONENT-TYPE>
